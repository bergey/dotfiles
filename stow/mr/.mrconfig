# -*- mode: conf; -*-
[dotfiles]
checkout = git clone 'git@github.com:bergey/dotfiles.git' 'dotfiles'

[records/org]
checkout = git clone 'ssh://git@github.com/bergey/org-mode.git' 'org'
update = emacsclient -e '(save-some-buffers t)'; git diff-index --quiet HEAD || git commit -am "automatic commit on $(hostname) $(date '+%Y-%m-%d %R')"; git pull --rebase; git push

[records/teallabs/trunk]
checkout = git clone 'git@github.com:bergey/bergey.github.io.git' 'trunk'

[records/resume]
checkout = git clone 'ssh://git@github.com/bergey/resume.git' 'resume'

[code/active/draft]
checkout = git clone 'ssh://git@github.com/bergey/draft.git' 'draft'
update = jj git push && jj git fetch

[code/active/scratch]
checkout = git clone 'ssh://git@github.com/bergey/scratch.git' 'scratch'

[code/active/tealsed]
checkout = git clone 'git@github.com:bergey/tealsed.git' 'tealsed'

[code/active/Model01-Firmware]
checkout = git clone 'git@github.com:bergey/Model01-Firmware.git' 'Model01-Firmware'

[code/utility]
checkout = git clone 'ssh://git@github.com/bergey/utility.git' 'utility'

[code/active/databoose]
checkout = git clone 'git@github.com:bergey/databoose.git' 'databoose'

[code/active/memex]
checkout = git clone 'git@github.com:bergey/memex.git' 'memex'

[code/active/picklebush]
checkout = git clone 'git@github.com:bergey/picklebush.git' 'picklebush'

[code/active/delivery]
checkout = git clone 'git@github.com:bergey/delivery.git' 'delivery'
